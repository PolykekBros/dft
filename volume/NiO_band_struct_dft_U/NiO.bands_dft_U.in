&CONTROL
    calculation = 'bands'
    prefix      = 'NiO'
    restart_mode = 'from_scratch'
    outdir      = '/home/iethseph2/kirkar/dft/volume/NiO_band_struct_dft_U/out'
    pseudo_dir  = '/home/iethseph2/kirkar/dft/volume/NiO_band_struct_dft_U/../../pot'
    tprnfor     = .true.
/
&SYSTEM
    ibrav = 5
    celldm(1) = 9.711
    celldm(4) = 0.8333
    nat   = 4
    ntyp  = 3
    
    noncolin = .true.
    lspinorb = .true.
    starting_magnetization(1) = 0.5
    starting_magnetization(2) = 0.5
    angle1(1) = 0.0
    angle1(2) = 180.0
    angle2(1) = 0.0
    angle2(2) = 0.0

    ecutwfc = 65
    ecutrho = 260
    nbnd = 80
/
&ELECTRONS
    mixing_beta = 0.1
    electron_maxstep = 300
    mixing_ndim = 14
    conv_thr    = 1d-9
/
ATOMIC_SPECIES
