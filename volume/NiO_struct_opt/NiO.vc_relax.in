&CONTROL
    calculation = 'vc-relax'
    prefix      = 'NiO'
    restart_mode = 'from_scratch'
    outdir      = '/home/iethseph2/kirkar/dft/volume/NiO_struct_opt/out'
    pseudo_dir  = '/home/iethseph2/kirkar/dft/volume/NiO_struct_opt/../../pot'
    tprnfor     = .true.
    etot_conv_thr = 1e-5
    forc_conv_thr = 1e-4 
/
&SYSTEM
    ibrav = 5
    celldm(1) = 9.711
    celldm(4) = 0.8333
    nat   = 4
    ntyp  = 3
    nspin = 4
    noncolin = .true.
    lspinorb = .true.
    angle1(1) = 0.0
    angle1(2) = 180.0
    angle2(1) = 0.0
    angle2(2) = 0.0
    ecutwfc = 65
    ecutrho = 650
/
&ELECTRONS
    mixing_beta = 0.1
    conv_thr    = 1d-9
    mixing_ndim = 14
    electron_maxstep = 1000
/
&IONS
/
&CELL
    cell_dofree='ibrav'
/
